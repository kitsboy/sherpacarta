# sherpacarta.org — Cloudflare Pages _headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://analytics.giveabit.io https://platform.twitter.com https://cdn.syndication.twimg.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://platform.twitter.com; font-src 'self' data: https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; media-src 'self' blob:; connect-src 'self' https://mempool.space https://api.satohash.io https://cdn.jsdelivr.net https://challenges.cloudflare.com https://analytics.giveabit.io https://cdn.syndication.twimg.com https://syndication.twitter.com wss://relay.damus.io wss://nos.lol wss://relay.snort.social wss://relay.nostr.band; frame-src 'self' https://sherpacarta.org https://challenges.cloudflare.com https://platform.twitter.com https://syndication.twitter.com https://twitter.com https://x.com https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*.css
  Content-Type: text/css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable

/sc-enhancements*.js
  Cache-Control: public, max-age=3600

/sc-upgrades*.js
  Cache-Control: public, max-age=3600

/sc-bundle.js
  Cache-Control: public, max-age=300, must-revalidate

/sc-core.js
  Cache-Control: public, max-age=300, must-revalidate

/sc-main.css
  Cache-Control: public, max-age=300, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/api/v1/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/metrics.json
  Content-Type: application/json
  Cache-Control: public, max-age=60
  Access-Control-Allow-Origin: *

/api/canada/*
  Cache-Control: no-store

/index.html
  Cache-Control: public, max-age=300

# Social preview cards — crawler-friendly (X/Twitterbot, WhatsApp, iMessage)
# Prefer JPEG /share.jpg as primary card (opaque, no query string)
/share.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/share.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/og/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/og/*
  Content-Type: image/png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# NIP-05 — must be application/json (not SPA HTML fallback)
/.well-known/nostr.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Accept
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/video/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400

/video/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=86400
