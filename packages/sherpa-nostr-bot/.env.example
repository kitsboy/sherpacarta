# Copy to .env on THOR only — never commit real values
#   export $(grep -v '^#' .env | xargs)

# REQUIRED — Cam places nsec from password manager into THOR secrets
SHERPA_NSEC=nsec1_your_secret_here

# Optional safety: must match sherpa@ pubkey (default is production sherpa)
# SHERPA_PUBKEY_HEX=7db5119f154648c8a93ef15ea86b25f5f89328c2e8e039537092758d787d72fd

# Comma-separated relays
# SHERPA_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.nostr.band

# 1 = log replies only, do not publish (week-1 safe mode)
# SHERPA_APPROVE=1

# Optional webhook (Telegram bridge / Kimi) for escalations
# SHERPA_ESCALATE_WEBHOOK=https://…

# State dir for rate limits + logs
# SHERPA_STATE_DIR=/var/lib/sherpa-bot
